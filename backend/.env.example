# Server settings
PORT=5000
NODE_ENV=development

# MySQL / TiDB Database settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=saviess_vep
DB_SSL=false

# JWT Authentication secrets (REQUIRED — server will not start without these)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Cloudinary Integration (Image Storage)
# Sign up at https://cloudinary.com and replace with your real credentials.
# File uploads will fail if these are not configured.
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# CORS configurations
CLIENT_URL=http://localhost:5173
